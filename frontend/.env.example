# Copy to .env only if you need to change these. Neither is needed for either
# of the normal ways SpecVault runs -- deployed, one process serves this UI and
# the API together; in development, Vite proxies /libraries to the backend.
# Vite only exposes variables prefixed with VITE_ to client code.

# Where `npm run dev` proxies API calls to.
# VITE_DEV_API=http://127.0.0.1:8000

# A backend on another host entirely, baked into the build. Leave this unset
# unless you mean it: a bundle built with it works only against that one host.
# VITE_API_BASE=
