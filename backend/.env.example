# Copy to .env and adjust. The filename must be exactly ".env" —
# python-dotenv's load_dotenv() will not pick up a file named "env".

# SQLite (default, local development)
DATABASE_URL=sqlite:///./specvault.db

# Where the lab share is described. Defaults to backend/share.json; set this
# only to keep a deployment's own copy somewhere else.
# SHARE_CONFIG=C:\ProgramData\SpecVault\share.json

# The built UI this process serves. Defaults to frontend/dist next to the
# backend, which is where `npm run build` puts it.
# UI_DIR=C:\ProgramData\SpecVault\ui

# Only when the UI is served from a different origin than the API. It is not
# in either normal setup, so leave this unset. Comma separated.
# CORS_ORIGINS=http://localhost:5173
